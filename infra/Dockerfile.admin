# Multi-stage Dockerfile for QuickSaaS Admin Operations UI
FROM node:22-alpine AS builder

WORKDIR /app

# Copy manifests
COPY package.json package-lock.json ./
COPY packages/types/package.json ./packages/types/
COPY admin/package.json ./admin/

# Install dependencies
RUN npm ci

# Copy source code
COPY packages/types ./packages/types
COPY admin ./admin

# Build shared types and admin bundle
RUN npm run build -w @quicksaas/types && npm run build -w admin

# Production static serving stage
FROM nginx:alpine AS runner

# Install curl for healthcheck
RUN apk add --no-cache curl

# Copy Nginx SPA configuration
COPY infra/nginx-spa.conf /etc/nginx/conf.d/default.conf

# Copy compiled static assets from builder
COPY --from=builder /app/admin/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:80/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
