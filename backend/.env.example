PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Leave DATABASE_URL empty or unset to use zero-config embedded PGlite (stored in ./.data/postgres)
# To use an external or Docker Postgres, provide a connection string:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/quicksaas

JWT_SECRET=quicksaas-dev-secret-change-in-production
